{
  "name": "resource-planning",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise resource planning & workforce data platform with project drill-down, dynamic employee tables and an embedded CRM.",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "start:hosted": "node --disable-warning=ExperimentalWarning server/index.js --hosted",
    "setup:admin": "node --disable-warning=ExperimentalWarning server/private-setup.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "demo": "node --disable-warning=ExperimentalWarning server/gen-dummy.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/private-setup.test.js tests/hosted.test.js tests/api.test.js tests/ui.smoke.mjs tests/guide.test.mjs tests/workbook.test.js tests/roster-cycle.test.js tests/pages.test.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js --reset",
    "check:filters": "node --disable-warning=ExperimentalWarning scripts/check-filters.js",
    "ask:check": "node --disable-warning=ExperimentalWarning tests/guide.browser.mjs",
    "build:pages": "node --disable-warning=ExperimentalWarning scripts/build-pages.js",
    "check:pages": "node --disable-warning=ExperimentalWarning scripts/build-pages.js --check",
    "test:signin-browser": "node --disable-warning=ExperimentalWarning tests/signin.browser.mjs",
    "test:pages-browser": "node tests/pages.browser.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@noble/hashes": "1.8.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1",
    "sql.js": "1.17.0"
  }
}
